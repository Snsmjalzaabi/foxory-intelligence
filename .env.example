# Run python scripts/setup.py to generate real secrets. Do not commit .env.
FOXORY_TOKEN=
POSTGRES_PASSWORD=
FOXORY_PORT=8000
# Keep localhost/127.0.0.1 for container health probes. Add your exact DNS name
# for a private HTTPS deployment; do not use a wildcard.
FOXORY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set to 1 behind HTTPS; forwarded scheme still requires a trusted proxy.
FOXORY_SECURE_COOKIES=0
# Exact proxy peer address/CIDR seen by Uvicorn. Never use *.
FORWARDED_ALLOW_IPS=127.0.0.1
# New installations: hardened PG17 image. Existing volumes need logical migration;
# never switch an old physical volume to modern. See docs/DATABASE_UPGRADE.md.
FOXORY_DATABASE_LAYOUT=modern
# Optional private SearXNG instance with JSON output enabled. Not bundled.
SEARXNG_URL=
# Native development only:
# FOXORY_DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/foxory.db
# OLLAMA_URL=http://127.0.0.1:11434
# FOXORY_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional local inference CPU thread budget (1–16). Cloud CPU verification used 2.
# FOXORY_INFERENCE_THREADS=2
# Optional guarded parallel council (default disabled):
# FOXORY_ALLOW_PARALLEL_COUNCIL=1

# Optional CPU-light background profile:
# FOXORY_BACKGROUND_CONTEXT=2048
# FOXORY_BACKGROUND_OUTPUT=256

# Task workers (1–2); local model calls remain sequential. Single API process only.
# FOXORY_WORKER_CONCURRENCY=1

# Optional separate Linux sandbox manager. Disabled by default. Never mount a
# Docker socket into app. See docs/SANDBOX_MANAGER.md before enabling.
FOXORY_ENABLE_SANDBOX=0
FOXORY_SANDBOX_URL=
# Optional verified Linux Unix-socket transport; URL must be empty when used.
FOXORY_SANDBOX_SOCKET=
FOXORY_SANDBOX_KEY=
# Manager-host settings only; not passed to the application container.
# OCI remains off until explicit opt-in AND active startup probes pass.
# FOXORY_SANDBOX_ENABLED=1
# FOXORY_SANDBOX_DATA=/private/path/owned-by-manager
# FOXORY_SANDBOX_OCI_ENABLED=0
# FOXORY_SANDBOX_OCI_IMAGE=sha256:REVIEWED_LOCAL_IMAGE_ID

# your computer standalone profile only (compose.local.yaml): existing host Ollama.
# FOXORY_HOST_OLLAMA_URL=http://127.0.0.1:11434
# FOXORY_LOCAL_DB_PORT=55432
# your computer API port is fixed at 3636; FOXORY_PORT above is for compose.yaml.

# Optional V7 CPU-only llama.cpp companion. scripts/foxory_ai.py enable installs
# a pinned model and enables the 'lite' Compose profile; no cloud/API account.
FOXORY_LLAMA_URL=
FOXORY_LLAMA_MODEL=qwen2.5-1.5b-instruct-q4_k_m

# Optional phone/desktop push for finished scheduled and automated tasks: a topic URL on a
# self-hosted ntfy server, e.g. http://192.168.1.10:8080/foxory. Pushes contain only the task
# title and status. A public server such as ntfy.sh would send those titles off this PC.
FOXORY_NTFY_URL=

# Optional watched folder: an absolute path whose supported documents (PDF, DOCX, XLSX, CSV,
# TXT, MD, JSON) sync into the local workspace every minute. Mounted read-only.
FOXORY_WATCH_DIR=

# Optional private HTTPS access from your phone; set by scripts/foxory_phone.py.
FOXORY_PUBLIC_ORIGINS=

# Profile in profiles/<name>.json (names, timezone, currency, starter prompts). Empty uses
# profiles/personal.json when present, otherwise profiles/default.json.
FOXORY_PROFILE=

# GPU for local models: auto (use an NVIDIA GPU when Docker can), on, or off (CPU only).
FOXORY_GPU=auto
