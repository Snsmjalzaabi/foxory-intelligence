# Run python scripts/setup.py to generate real secrets. Do not commit .env.
FOXORY_TOKEN=
POSTGRES_PASSWORD=
FOXORY_PORT=8000
# Optional private SearXNG instance with JSON output enabled. Not bundled.
SEARXNG_URL=
# Native development only:
# FOXORY_DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/foxory.db
# OLLAMA_URL=http://127.0.0.1:11434
# FOXORY_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional local inference CPU thread budget (1–16). Cloud CPU verification used 2.
# FOXORY_INFERENCE_THREADS=2
# Optional guarded parallel council (default disabled):
# FOXORY_ALLOW_PARALLEL_COUNCIL=1

# Optional CPU-light background profile:
# FOXORY_BACKGROUND_CONTEXT=2048
# FOXORY_BACKGROUND_OUTPUT=256

# Task workers (1–2); local model calls remain sequential. Single API process only.
# FOXORY_WORKER_CONCURRENCY=1

# Optional separate Linux sandbox manager. Disabled by default. Never mount a
# Docker socket into app. See docs/SANDBOX_MANAGER.md before enabling.
FOXORY_ENABLE_SANDBOX=0
FOXORY_SANDBOX_URL=
# Optional verified Linux Unix-socket transport; URL must be empty when used.
FOXORY_SANDBOX_SOCKET=
FOXORY_SANDBOX_KEY=
# Manager-host settings only; not passed to the application container.
# OCI remains off until explicit opt-in AND active startup probes pass.
# FOXORY_SANDBOX_ENABLED=1
# FOXORY_SANDBOX_DATA=/private/path/owned-by-manager
# FOXORY_SANDBOX_OCI_ENABLED=0
# FOXORY_SANDBOX_OCI_IMAGE=sha256:REVIEWED_LOCAL_IMAGE_ID
