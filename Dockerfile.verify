# Local verification overlay for a previously built Phase 2 base image.
# This avoids repeating dependency/UI build stages under cloud VFS storage limits.
# For installation/distribution, use the canonical Dockerfile instead.
FROM foxory-intelligence-app:phase2-base
COPY --chown=10001:10001 backend/ /app/backend/
COPY --chown=10001:10001 frontend/dist/ /app/frontend/dist/
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.txt /usr/share/doc/foxory/
